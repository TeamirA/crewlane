# Postgres (Supabase): pooled connection for the app, direct connection for migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crewlane?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crewlane?schema=public"

# Auth: generate each with `openssl rand -base64 48`
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Supabase Realtime
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Project JWT secret (Settings -> API -> JWT Settings), used to sign realtime channel tokens
SUPABASE_JWT_SECRET=""

# Integration tests (dedicated database, emptied before each run)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crewlane_test"
